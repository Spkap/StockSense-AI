# StockSense Agent - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# Backend API Keys (Required)
# =============================================================================

# Fireworks AI API Key - backend only
FIREWORKS_API_KEY=""
FIREWORKS_MODEL="accounts/fireworks/models/deepseek-v4p1-flash-1017"

# NewsAPI Key - Get from https://newsapi.org/register
NEWSAPI_KEY=""

# =============================================================================
# Supabase (Required for User Features)
# =============================================================================

# Supabase Project URL
SUPABASE_URL=""

# Supabase Anonymous Key (public, safe for frontend)
SUPABASE_ANON_KEY=""

# Supabase Service Key (private, backend only - DO NOT expose)
SUPABASE_SERVICE_KEY=""

# =============================================================================
# Frontend Environment (for Vite - prefix with VITE_)
# =============================================================================

# Copy these to frontend/.env as well
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_API_URL="http://127.0.0.1:8000"

# =============================================================================
# Server Configuration (Optional)
# =============================================================================

# Port for FastAPI (default: 8000 — overridden by Render/Railway automatically)
PORT=8000

# Enable uvicorn hot-reload — dev only, NEVER true in production
UVICORN_RELOAD=false

# Log level: debug | info | warning | error
LOG_LEVEL=info

# CORS allowed origins — comma-separated for production
# Example: https://stocksense.yourdomain.com
# Use * for local dev only
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
